---
// src/components/CertificatesCard.astro

const certificates = [
  {
    id: "cert-database",
    img: "/image/certification_2.svg",
    title: "Database Design & Database Programming",
    issuer: "Digital Talent Scholarship"
  },
  {
    id: "cert-flutter",
    img: "/image/certification_4.svg",
    title: "Membuat Aplikasi Flutter Pemula",
    issuer: "Dicoding Indonesia"
  },
  {
    id: "cert-frontend",
    img: "/image/certification_5.svg",
    title: "Frontend Web Pemula",
    issuer: "Dicoding Indonesia"
  },
  {
    id: "cert-react",
    img: "/image/certification_3.svg",
    title: "React Developer",
    issuer: "DTS - Kominfo"
  }
];
---

<div class="bg-[#151224] border border-white/5 rounded-[2rem] p-8 flex flex-col justify-start text-white shadow-lg md:col-span-2 min-h-[340px]">
  <h2 class="text-2xl font-bold tracking-tight mb-6">Certificates</h2>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {certificates.map((cert) => (
      <a href={`#${cert.id}`} class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden hover:bg-white/10 transition flex flex-col group cursor-zoom-in">
        <div class="w-full h-32 bg-gray-800 overflow-hidden">
          <img src={cert.img} alt={cert.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>
        <div class="p-4 flex flex-col justify-between flex-1">
          <h3 class="text-xs font-semibold leading-snug">{cert.title}</h3>
          <p class="text-[10px] text-white/45 mt-1">{cert.issuer}</p>
        </div>
      </a>
    ))}
  </div>
</div>


{certificates.map((cert) => (
  <div id={cert.id} class="modal-overlay fixed inset-0 z-[100] flex items-center justify-center bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 ease-out target:opacity-100 target:pointer-events-auto">
    <a href="#" class="absolute inset-0 cursor-default" aria-label="Close modal"></a>
    <a href="#" class="absolute top-6 right-6 text-white/70 hover:text-white text-4xl focus:outline-none transition-all hover:scale-110 decoration-none">&times;</a>
    <div class="modal-content max-w-[90%] max-h-[85%] relative overflow-hidden rounded-2xl border border-white/10 shadow-2xl scale-95 transition-all duration-300 ease-out">
      <img src={cert.img} alt={cert.title} class="max-w-full max-h-[80vh] object-contain rounded-2xl" />
    </div>
  </div>
))}

<style>
  .modal-overlay:target .modal-content {
    transform: scale(1);
  }
</style>
