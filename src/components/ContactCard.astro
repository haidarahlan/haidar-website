---
---

<div class="bg-gradient-to-br from-[#10b981] via-[#06b6d4] to-[#3b82f6] rounded-[2rem] p-8 flex flex-col text-white shadow-lg min-h-[340px]">
  <h2 class="text-2xl font-bold tracking-tight mb-4">Contact Me</h2>
  <div class="space-y-4">
    <a href="mailto:ahlangaffar@gmail.com" class="bg-white/10 border border-white/20 rounded-2xl p-4 flex items-center justify-between hover:bg-white/15 transition cursor-pointer block">
      <div class="flex items-center gap-3">
        <span class="text-xl">📧</span>
        <div>
          <p class="text-[10px] text-white/60 uppercase tracking-wider font-semibold">Email</p>
          <p class="text-xs md:text-sm font-medium">ahlangaffar@gmail.com</p>
        </div>
      </div>
      <button id="copy-email-btn" class="text-white/60 hover:text-white transition relative z-10">
        📋
      </button>
    </a>
    <a href="https://drive.google.com/file/d/1tyl7PI0tBYZfzyFVQHYJHxgOnsFnCeo9/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="bg-white/10 border border-white/20 rounded-2xl p-4 flex items-center gap-3 hover:bg-white/15 transition cursor-pointer block">
      <div class="w-6 h-6 flex items-center justify-center shrink-0">
        <span class="text-xl">📪</span>
      </div>
      <div>
        <p class="text-[10px] text-white/60 uppercase tracking-wider font-semibold">My Resume</p>
        <p class="text-xs md:text-sm font-medium">Haidar Ahlan G - CV ATS</p>
      </div>
    </a>
    
    <div id="spotify-card" class="bg-white/10 border border-white/20 rounded-2xl p-4 flex flex-col gap-3 cursor-pointer hover:bg-white/15 transition relative overflow-hidden group select-none">
      <div class="flex items-center justify-between w-full">
        <div class="flex items-center gap-3">
          <div class="w-6 h-6 flex items-center justify-center shrink-0 rounded-full overflow-hidden">
            <img id="spotify-logo" src={import.meta.env.BASE_URL + "image/foto_musik.png"} alt="Spotify" class="w-full h-full object-cover" />
          </div>
          <div>
            <p class="text-[10px] text-white/60 uppercase tracking-wider font-semibold">Favorite Music</p>
            <p class="text-xs md:text-sm font-medium">Daniel Caesar - Disillusioned</p>
          </div>
        </div>
        
        <!-- Controls Container -->
        <div class="flex items-center gap-3 shrink-0">
          <!-- Visualizer Gelombang Musik -->
          <div class="flex items-end gap-[3px] h-4 opacity-0 transition-opacity duration-300" id="visualizer">
            <div class="w-[2px] bg-white rounded-full eq-bar-1" style="height: 4px;"></div>
            <div class="w-[2px] bg-white rounded-full eq-bar-2" style="height: 4px;"></div>
            <div class="w-[2px] bg-white rounded-full eq-bar-3" style="height: 4px;"></div>
            <div class="w-[2px] bg-white rounded-full eq-bar-4" style="height: 4px;"></div>
          </div>

          <!-- Play Button -->
          <div class="w-7 h-7 flex items-center justify-center rounded-full bg-white/10 group-hover:bg-white/20 transition-all shrink-0" id="play-btn">
            <span class="text-xs ml-0.5" id="play-icon">▶</span>
          </div>
        </div>
      </div>

      <!-- Garis Progress Lagu -->
      <div class="w-full bg-white/25 h-1 rounded-full overflow-hidden relative cursor-pointer" id="progress-container">
        <div class="bg-white h-full w-0 rounded-full transition-all duration-100" id="progress-bar"></div>
      </div>
    </div>
  </div>

  <!-- Audio Player Element -->
  <audio id="music-player" src={import.meta.env.BASE_URL + "music/Disillusioned.mp3"} preload="metadata"></audio>

  <div class="mt-6 pt-4 border-t border-white/10">
    <p class="text-[10px] text-white/60 uppercase tracking-wider font-semibold mb-3">Connect with me</p>
    <div class="flex flex-wrap gap-2">
      <a href="https://github.com/haidarahlan" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-xl text-xs font-medium transition flex items-center gap-1.5">
        <img src={import.meta.env.BASE_URL + "logo/github.svg"} alt="GitHub" class="w-4 h-4 invert" />
        GitHub
      </a>
      <a href="https://www.linkedin.com/in/haidar-ahlan-ghaffar/" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-xl text-xs font-medium transition flex items-center gap-1.5">
        <img src={import.meta.env.BASE_URL + "logo/linkedinnew.svg"} alt="LinkedIn" class="w-4 h-4" />
        LinkedIn
      </a>
      <a href="https://www.instagram.com/haidarahlanz/" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-xl text-xs font-medium transition flex items-center gap-1.5">
        <img src={import.meta.env.BASE_URL + "logo/instagram.svg"} alt="Instagram" class="w-4 h-4" />
        Instagram
      </a>
    </div>
  </div>
</div>

<style>
  @keyframes eq-bar {
    0%, 100% { height: 4px; }
    50% { height: 16px; }
  }
  .eq-bar-1 { animation: eq-bar 0.8s ease-in-out infinite; }
  .eq-bar-2 { animation: eq-bar 0.5s ease-in-out infinite 0.15s; }
  .eq-bar-3 { animation: eq-bar 0.7s ease-in-out infinite 0.3s; }
  .eq-bar-4 { animation: eq-bar 0.6s ease-in-out infinite 0.05s; }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 8s linear infinite;
  }
</style>

<script>
  import Swal from 'sweetalert2';
  import 'sweetalert2/dist/sweetalert2.min.css';

  const audio = document.getElementById('music-player') as HTMLAudioElement;
  const card = document.getElementById('spotify-card');
  const playIcon = document.getElementById('play-icon');
  const progressBar = document.getElementById('progress-bar');
  const progressContainer = document.getElementById('progress-container');
  const visualizer = document.getElementById('visualizer');
  const spotifyLogo = document.getElementById('spotify-logo');
  const copyBtn = document.getElementById('copy-email-btn');



  // Handle Email Copy
  if (copyBtn) {
    copyBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      navigator.clipboard.writeText('ahlangaffar@gmail.com').then(() => {
        Swal.fire({
          title: 'Copied!',
          text: 'Email address has been copied to your clipboard.',
          icon: 'success',
          toast: true,
          position: 'top-end',
          showConfirmButton: false,
          timer: 2000,
          timerProgressBar: true,
          background: '#1e293b',
          color: '#fff',
          iconColor: '#10b981'
        });
      }).catch(err => {
        console.error('Failed to copy email: ', err);
      });
    });
  }

  if (audio && card && playIcon && progressBar && progressContainer && visualizer && spotifyLogo) {
    card.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('#progress-container')) return;

      if (audio.paused) {
        audio.play().catch(err => console.log("Audio play failed:", err));
        playIcon.textContent = '⏸';
        playIcon.classList.remove('ml-0.5');
        visualizer.classList.remove('opacity-0');
        visualizer.classList.add('opacity-80');
        
        spotifyLogo.classList.add('animate-spin-slow');
        spotifyLogo.style.animationPlayState = 'running';
      } else {
        audio.pause();
        playIcon.textContent = '▶';
        playIcon.classList.add('ml-0.5');
        visualizer.classList.add('opacity-0');
        visualizer.classList.remove('opacity-80');
        
        spotifyLogo.style.animationPlayState = 'paused';
      }
    });

    progressContainer.addEventListener('click', (e) => {
      e.stopPropagation();
      const rect = progressContainer.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const width = rect.width;
      const duration = audio.duration;
      if (duration) {
        audio.currentTime = (clickX / width) * duration;
      }
    });

    audio.addEventListener('timeupdate', () => {
      if (audio.duration) {
        const percentage = (audio.currentTime / audio.duration) * 100;
        progressBar.style.width = `${percentage}%`;
      }
    });

    audio.addEventListener('ended', () => {
      playIcon.textContent = '▶';
      playIcon.classList.add('ml-0.5');
      progressBar.style.width = '0%';
      visualizer.classList.add('opacity-0');
      visualizer.classList.remove('opacity-80');
      spotifyLogo.style.animationPlayState = 'paused';
    });
  }
</script>
