---
// src/components/HeroCard.astro
---

<div class="bg-gradient-to-br from-[#06b6d4] via-[#10b981] to-[#eab308] rounded-[2rem] p-8 md:p-10 flex flex-col justify-between text-white relative shadow-lg min-h-[340px] md:col-span-2 overflow-hidden">
  <div class="flex items-start justify-between w-full z-10">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-full border-2 border-white overflow-hidden flex items-center justify-center bg-white shadow-md">
        <img src={import.meta.env.BASE_URL + "image/my_avatar.webp"} alt="Haidar Avatar" class="w-full h-full object-cover" />
      </div>
      <div>
        <h2 class="text-lg font-bold leading-tight">Hello, i'm Haidar</h2>
        <p class="text-sm text-white/80">Developer</p>
      </div>
    </div>
    
    <div class="flex items-center gap-3">
      <a href="https://www.linkedin.com/in/haidar-ahlan-ghaffar/" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 p-2 rounded-lg transition w-9 h-9 flex items-center justify-center">
        <img src={import.meta.env.BASE_URL + "logo/linkedinnew.svg"} alt="LinkedIn" class="w-5 h-5" />
      </a>
      <a href="https://github.com/haidarahlan" target="_blank" rel="noopener noreferrer" class="bg-white/10 hover:bg-white/20 p-2 rounded-lg transition w-9 h-9 flex items-center justify-center">
        <img src={import.meta.env.BASE_URL + "logo/github.svg"} alt="GitHub" class="w-5 h-5 invert" />
      </a>
    </div>
  </div>


  <div class="mt-6 flex flex-col md:flex-row items-end justify-between gap-6">
    <div class="flex-1 md:max-w-[55%] pb-36 md:pb-0 z-10">
      <h1 class="text-5xl md:text-[3.8rem] lg:text-[4.5rem] font-extrabold tracking-tight leading-[1.1] mb-5">
        Learn <br/>By <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 to-yellow-400">Doing.</span>
      </h1>
      <p class="text-white/90 text-base md:text-lg leading-relaxed font-normal">
        Software Engineer with 2 years of experience, build web applications for bussines support.
      </p>
    </div>
    

    <div class="absolute bottom-0 right-4 md:right-10 w-64 md:w-80 flex items-end justify-center pointer-events-none">
      <img src={import.meta.env.BASE_URL + "image/haidar-background.webp"} alt="Haidar Background" class="w-full h-auto object-contain" />
    </div>
  </div>
</div>
